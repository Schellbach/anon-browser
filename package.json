{
  "name": "anon-browser",
  "productName": "Anon",
  "desktopName": "Anon.desktop",
  "version": "0.3.0",
  "description": "Anon Browser — privacy browser with a built-in Bitcoin Vault",
  "main": "src/main.js",
  "author": "Anon Computer, Inc.",
  "license": "MIT",
  "scripts": {
    "brand": "node scripts/brand-electron-app.js",
    "prestart": "node scripts/brand-electron-app.js",
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "predev": "node scripts/brand-electron-app.js",
    "dev": "env -u ELECTRON_RUN_AS_NODE electron . --dev",
    "pack": "env -u ELECTRON_RUN_AS_NODE electron-builder --dir --publish never",
    "dist": "npm run dist:mac",
    "dist:mac": "env -u ELECTRON_RUN_AS_NODE CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip --arm64 --publish never",
    "dist:mac:signed": "env -u ELECTRON_RUN_AS_NODE electron-builder --mac dmg --arm64 --publish never",
    "dist:linux": "env -u ELECTRON_RUN_AS_NODE electron-builder --linux AppImage tar.gz --x64 --publish never",
    "test": "npm run test:unit && npm run test:electron",
    "test:unit": "node --test test/*.test.js",
    "test:electron": "node test/run-electron-smoke.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "computer.anon.browser",
    "productName": "Anon",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "renderer/**",
      "privacy/**",
      "vault/**",
      "brand/icon.png",
      "brand/icon.icns",
      "brand/fonts/**",
      "LICENSE",
      "TRADEMARKS.md",
      "package.json"
    ],
    "mac": {
      "icon": "brand/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "Anon-${version}-${arch}-mac.${ext}"
    },
    "dmg": {
      "title": "Anon"
    },
    "linux": {
      "icon": "brand/icon.png",
      "category": "Network",
      "maintainer": "Anon Computer, Inc.",
      "executableName": "anon",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Anon-${version}-${arch}-linux.${ext}"
    },
    "publish": null
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.18.1",
    "@scure/base": "^2.0.0",
    "@scure/bip32": "^2.2.0",
    "@scure/bip39": "^2.2.0",
    "@scure/btc-signer": "^2.2.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "44.4.2",
    "electron-builder": "^26.15.3"
  }
}
